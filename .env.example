# Copy this file to ".env" to change settings on your own computer.
# On Render, set these in the service's "Environment" tab instead. Never upload a real .env file.
ENV=development
SECRET_KEY=change-me-to-a-long-random-value-at-least-32-characters
DATABASE_URL=sqlite:///./local.db
PUBLIC_BASE_URL=http://localhost:8000
# true = fictional demo data + one-click demo logins (computer / testing deployment only)
DEMO_MODE=true
CURRENCY=SAR
# database (default, survives restarts) or local (folder below; development only)
STORAGE_BACKEND=database
LOCAL_STORAGE_DIR=./uploads
MAX_UPLOAD_MB=25
SESSION_HOURS=12
# Optional extra administrators (register the account first, then add its e-mail here)
ADMIN_EMAILS=
# The old EngConnect Stripe code is NOT part of this prototype. Leave these empty / false.
LEGACY_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
